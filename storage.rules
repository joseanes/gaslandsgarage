rules_version = '2';
// Painted-car photos. The signed-in owner can read and write only their own
// private files. A shared copy lives at shared-photos/{photoId} with no account
// id. Clients cannot write that path. Reads follow the sharing documents.
service firebase.storage {
  match /b/{bucket}/o {
    function owner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function sharedDoc(photoId) {
      return firestore.get(/databases/(default)/documents/sharedPhotos/$(photoId));
    }

    function privateDoc(photoId) {
      return firestore.get(/databases/(default)/documents/sharedPhotoPrivate/$(photoId));
    }

    function galleryVisible(photoId) {
      return firestore.exists(/databases/(default)/documents/sharedPhotos/$(photoId))
        && sharedDoc(photoId).data.hidden == false
        && sharedDoc(photoId).data.published == true
        && sharedDoc(photoId).data.showInGallery == true;
    }

    function shareLinkVisible(photoId) {
      return firestore.exists(/databases/(default)/documents/sharedPhotoPrivate/$(photoId))
        && privateDoc(photoId).data.hidden == false
        && privateDoc(photoId).data.showOnShareLink == true;
    }

    function acceptedBuddy(ownerUid) {
      let pair = request.auth.uid < ownerUid
        ? request.auth.uid + '~' + ownerUid
        : ownerUid + '~' + request.auth.uid;
      return request.auth != null
        && request.auth.uid.matches('^[A-Za-z0-9_-]{1,128}$')
        && ownerUid.matches('^[A-Za-z0-9_-]{1,128}$')
        && request.auth.uid != ownerUid
        && firestore.exists(/databases/(default)/documents/buddies/$(pair))
        && firestore.get(/databases/(default)/documents/buddies/$(pair)).data.status == 'accepted'
        && firestore.get(/databases/(default)/documents/buddies/$(pair)).data.members.size() == 2
        && firestore.get(/databases/(default)/documents/buddies/$(pair)).data.members.hasAll([request.auth.uid, ownerUid]);
    }

    function buddyVisible(photoId) {
      return request.auth != null
        && firestore.exists(/databases/(default)/documents/sharedPhotoPrivate/$(photoId))
        && privateDoc(photoId).data.hidden == false
        && privateDoc(photoId).data.showToBuddies == true
        && acceptedBuddy(privateDoc(photoId).data.ownerUid);
    }

    function storageAdmin() {
      return request.auth != null
        && firestore.exists(/databases/(default)/documents/roles/$(request.auth.uid))
        && firestore.get(/databases/(default)/documents/roles/$(request.auth.uid)).data.role == 'Administrator'
        && !(
          firestore.exists(/databases/(default)/documents/adminUsers/$(request.auth.uid))
          && firestore.get(/databases/(default)/documents/adminUsers/$(request.auth.uid)).data.disabled == true
        );
    }

    function safeIds(teamId, vehicleId) {
      return teamId.matches('^[A-Za-z0-9_-]{1,40}$')
        && vehicleId.matches('^[A-Za-z0-9_-]{1,64}$');
    }

    function webpFile(fileName) {
      return fileName.matches('^[A-Za-z0-9_-]{8,40}\\.webp$')
        && request.resource.contentType == 'image/webp';
    }

    function jpegFile(fileName) {
      return fileName.matches('^[A-Za-z0-9_-]{8,40}\\.jpe?g$')
        && request.resource.contentType == 'image/jpeg';
    }

    function photoRecord(uid, photoId) {
      return /databases/(default)/documents/users/$(uid)/photos/$(photoId);
    }

    // The callable creates users/{uid}/photos/{photoId} inside the quota transaction.
    // Clients cannot create that document, so a file can exist only after a reservation
    // that already counted toward 3 per vehicle and 100 per account.
    function reservedPhoto(uid, teamId, vehicleId, fileName) {
      let photoId = fileName.split('\\.')[0];
      let record = photoRecord(uid, photoId);
      return photoId.matches('^[A-Za-z0-9_-]{8,40}$')
        && firestore.exists(record)
        && firestore.get(record).data.userId == uid
        && firestore.get(record).data.teamId == teamId
        && firestore.get(record).data.vehicleId == vehicleId
        && firestore.get(record).data.path == 'users/' + uid + '/vehicle-photos/' + teamId + '/' + vehicleId + '/' + fileName
        && firestore.get(record).data.contentType == request.resource.contentType;
    }

    match /users/{uid}/vehicle-photos/{teamId}/{vehicleId}/{fileName} {
      allow read: if owner(uid) && safeIds(teamId, vehicleId);

      // About 1.5 MiB. Delete is separate so a delete is not required to send a content type
      // or to still have the reservation document.
      allow create, update: if owner(uid)
        && safeIds(teamId, vehicleId)
        && request.resource.size <= 1572864
        && (webpFile(fileName) || jpegFile(fileName))
        && reservedPhoto(uid, teamId, vehicleId, fileName);

      allow delete: if owner(uid);
    }

    match /shared-photos/{photoId} {
      allow read: if photoId.matches('^[A-Za-z0-9_-]{8,40}$')
        && (storageAdmin() || galleryVisible(photoId) || shareLinkVisible(photoId) || buddyVisible(photoId));
      allow write: if false;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
