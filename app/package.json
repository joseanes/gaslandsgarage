{
	"name": "app",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build --mode production",
		"build:staging": "vite build --mode staging",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage",
		"test:e2e": "playwright test",
		"test:rules": "pnpm --config.engine-strict=false dlx firebase-tools@13.29.1 emulators:exec --only firestore,storage --project demo-gaslands-rules --config ../firebase.json \"pnpm exec vitest run --config vitest.rules.config.ts && pnpm exec vitest run --config vitest.storage.config.ts\""
	},
	"devDependencies": {
		"@firebase/rules-unit-testing": "4.0.1",
		"@playwright/test": "^1.64.1",
		"@sveltejs/adapter-auto": "^6.1.1",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.70.3",
		"@sveltejs/vite-plugin-svelte": "^5.1.1",
		"@testing-library/svelte": "^5.4.2",
		"@types/leaflet": "1.9.21",
		"@types/qrcode": "^1.5.6",
		"@vitest/coverage-v8": "^4.1.12",
		"autoprefixer": "^10.6.2",
		"firebase-admin": "13.10.0",
		"jsdom": "^26.1.0",
		"postcss": "^8.5.32",
		"svelte": "^5.57.3",
		"svelte-check": "^4.7.7",
		"tailwindcss": "3.4.3",
		"typescript": "^5.9.3",
		"vite": "^6.4.5",
		"vitest": "^4.1.12"
	},
	"packageManager": "pnpm@10.10.0+sha512.d615db246fe70f25dcfea6d8d73dee782ce23e2245e3c4f6f888249fb568149318637dca73c2c5c8ef2a4ca0d5657fb9567188bfab47f566d1ee6ce987815c39",
	"dependencies": {
		"firebase": "^11.10.0",
		"leaflet": "1.9.4",
		"nanoid": "^5.1.16",
		"qrcode": "^1.5.4",
		"zod": "^3.25.76"
	}
}
