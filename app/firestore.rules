rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    // adminUsers/{uid} is written only by an administrator (or the Admin SDK).
    // A missing document means the account is active.
    // accountControl/{uid}.deleted is written only by account deletion. It stays
    // after the Auth user is gone so a still-valid ID token cannot write again.
    function isDisabled() {
      return signedIn()
        && (
          (
            exists(/databases/$(database)/documents/adminUsers/$(request.auth.uid))
            && get(/databases/$(database)/documents/adminUsers/$(request.auth.uid)).data.disabled == true
          )
          || (
            exists(/databases/$(database)/documents/accountControl/$(request.auth.uid))
            && get(/databases/$(database)/documents/accountControl/$(request.auth.uid)).data.deleted == true
          )
        );
    }

    // Only the Administrator role can manage users. More roles can be stored later;
    // they do not pass this check until the rules learn about them.
    function isAdmin() {
      return signedIn()
        && !isDisabled()
        && exists(/databases/$(database)/documents/roles/$(request.auth.uid))
        && get(/databases/$(database)/documents/roles/$(request.auth.uid)).data.role == 'Administrator';
    }

    function roleWrite(userId) {
      return isAdmin()
        && userId != request.auth.uid
        && request.resource.data.keys().hasOnly(['role', 'updatedAt', 'updatedBy'])
        && request.resource.data.keys().hasAll(['role', 'updatedAt', 'updatedBy'])
        && request.resource.data.role is string
        && request.resource.data.role.matches('^[A-Za-z][A-Za-z0-9 ]{0,62}$')
        && request.resource.data.updatedAt is string
        && request.resource.data.updatedAt.size() < 40
        && request.resource.data.updatedBy == request.auth.uid;
    }

    function accountControlWrite(userId) {
      return isAdmin()
        && userId != request.auth.uid
        && request.resource.data.keys().hasOnly(['disabled', 'disabledAt', 'disabledBy'])
        && request.resource.data.keys().hasAll(['disabled', 'disabledAt', 'disabledBy'])
        && request.resource.data.disabled is bool
        && (
          (
            request.resource.data.disabled == true
            && request.resource.data.disabledAt is string
            && request.resource.data.disabledAt.size() < 40
            && request.resource.data.disabledBy == request.auth.uid
          )
          || (
            request.resource.data.disabled == false
            && request.resource.data.disabledAt == null
            && request.resource.data.disabledBy == null
          )
        );
    }

    // \x40 is the at-sign. Public text rejects it so a profile cannot smuggle an
    // email address. The rules file keeps the hex escape on purpose.
    function noEmail(value) {
      return value is string && value.matches('^[^\\x40]*$');
    }

    function shortText(value, max) {
      return noEmail(value) && value.size() <= max;
    }

    // Same street and unit words the profile form rejects. A 5-digit ZIP is allowed.
    // Rules match the whole string, so each pattern is anchored with .*.
    function streetish(value) {
      return value.matches('(?i).*\\b(street|avenue|boulevard|lane|drive|court|place|terrace|highway|parkway|trail|circle|road|alley|square)\\b.*')
        || value.matches('(?i).*[A-Za-z][A-Za-z.\\-]{0,40} +(st|ave|blvd|ln|dr|ct|pl|rd|hwy|pkwy)\\b.*')
        || value.matches('(?i).*\\b(apt|apartment|unit|suite|ste|floor|bldg|building)\\b.*')
        || value.matches('.*#.*');
    }

    function locationLabelOk(value) {
      return value is string
        && value.size() <= 80
        && noEmail(value)
        && (
          value.size() == 0
          || value.matches('^\\d{5}$')
          || (!value.matches('.*[0-9].*') && !streetish(value))
        );
    }

    // placeMapPoint writes this. Clients cannot. A new or moved point must match it.
    function placedPoint(lat, lng) {
      return exists(/databases/$(database)/documents/mapPlacements/$(request.auth.uid))
        && get(/databases/$(database)/documents/mapPlacements/$(request.auth.uid)).data.latE2 == lat
        && get(/databases/$(database)/documents/mapPlacements/$(request.auth.uid)).data.lngE2 == lng;
    }

    function profilePointOk() {
      return request.resource.data.latE2 == null
        || (
          resource != null
          && request.resource.data.latE2 == resource.data.latE2
          && request.resource.data.lngE2 == resource.data.lngE2
        )
        || placedPoint(request.resource.data.latE2, request.resource.data.lngE2);
    }

    function storedPointOk() {
      return (
        resource != null
        && request.resource.data.latE2 == resource.data.latE2
        && request.resource.data.lngE2 == resource.data.lngE2
      ) || placedPoint(request.resource.data.latE2, request.resource.data.lngE2);
    }

    function markerPointOk(pin, previous) {
      return (
        previous != null
        && previous.latE2 == pin.latE2
        && previous.lngE2 == pin.lngE2
      ) || placedPoint(pin.latE2, pin.lngE2);
    }

    function hundredth(value, min, max) {
      return value is int && value >= min && value <= max;
    }

    function optionalHundredth(value, min, max) {
      return value == null || hundredth(value, min, max);
    }

    function validPlayerProfile() {
      return request.resource.data.keys().hasOnly([
          'playerName', 'bio', 'locationLabel', 'playSpots',
          'latE2', 'lngE2', 'showOnMap', 'anonymousOnMap', 'openToGames',
          'mapEntryId', 'updatedAt'
        ])
        && shortText(request.resource.data.playerName, 60)
        && shortText(request.resource.data.bio, 280)
        && locationLabelOk(request.resource.data.locationLabel)
        && profilePointOk()
        && shortText(request.resource.data.playSpots, 280)
        && optionalHundredth(request.resource.data.latE2, -9000, 9000)
        && optionalHundredth(request.resource.data.lngE2, -18000, 18000)
        && request.resource.data.showOnMap is bool
        && request.resource.data.anonymousOnMap is bool
        && request.resource.data.openToGames is bool
        && request.resource.data.mapEntryId is string
        && (
          request.resource.data.mapEntryId == ''
          || request.resource.data.mapEntryId.matches('^[A-Za-z0-9]{20,40}$')
        )
        && request.resource.data.updatedAt is string
        && request.resource.data.updatedAt.size() < 40
        && (
          !request.resource.data.showOnMap
          || (
            hundredth(request.resource.data.latE2, -9000, 9000)
            && hundredth(request.resource.data.lngE2, -18000, 18000)
          )
        )
        && (
          !(request.resource.data.showOnMap && request.resource.data.anonymousOnMap == false)
          || request.resource.data.playerName.size() > 0
        )
        && (!request.resource.data.openToGames || request.resource.data.playerName.size() > 0);
    }

    function ownsMapClaim(entryId) {
      return signedIn()
        && !isDisabled()
        && entryId != request.auth.uid
        && entryId.matches('^[A-Za-z0-9]{20,40}$')
        && exists(/databases/$(database)/documents/playerMapOwners/$(request.auth.uid))
        && get(/databases/$(database)/documents/playerMapOwners/$(request.auth.uid)).data.entryId == entryId;
    }

    function coarsePoint(pin) {
      return hundredth(pin.latE2, -9000, 9000)
        && hundredth(pin.lngE2, -18000, 18000)
        && pin.updatedAt is string
        && pin.updatedAt.size() < 40;
    }

    function anonPin(pin) {
      return pin is map
        && pin.keys().hasOnly(['anonymous', 'latE2', 'lngE2', 'updatedAt'])
        && pin.anonymous == true
        && coarsePoint(pin);
    }

    function namedPin(pin) {
      return pin is map
        && pin.keys().hasOnly([
          'anonymous', 'playerName', 'bio', 'playSpots', 'locationLabel',
          'latE2', 'lngE2', 'openToGames', 'updatedAt'
        ])
        && pin.anonymous == false
        && shortText(pin.playerName, 60)
        && pin.playerName.size() > 0
        && shortText(pin.bio, 280)
        && shortText(pin.playSpots, 280)
        && locationLabelOk(pin.locationLabel)
        && pin.openToGames is bool
        && coarsePoint(pin);
    }

    function validPublicPin(pin) {
      return anonPin(pin) || namedPin(pin);
    }

    function anonMapEntry() {
      return anonPin(request.resource.data);
    }

    function namedMapEntry() {
      return namedPin(request.resource.data);
    }

    function openCard(card) {
      return card is map
        && card.keys().hasOnly(['playerName', 'bio', 'playSpots', 'updatedAt'])
        && shortText(card.playerName, 60)
        && card.playerName.size() > 0
        && shortText(card.bio, 280)
        && shortText(card.playSpots, 280)
        && card.updatedAt is string
        && card.updatedAt.size() < 40;
    }

    function validOpenToGames() {
      return openCard(request.resource.data);
    }

    // Board documents stay under the 1 MiB Firestore limit. A player can add
    // only their own key, and cannot grow a board that is already full.
    function boardGrowthOk(after, before) {
      return after.size() <= 500 || (before != null && after.size() <= before.size());
    }

    function boardBytesOk() {
      return request.resource.size() < 800000
        || (resource != null && request.resource.size() <= resource.size());
    }

    function onlyOwnMarker(after, before) {
      let entryId = get(/databases/$(database)/documents/playerMapOwners/$(request.auth.uid)).data.entryId;
      return ownsMapClaim(entryId)
        && exists(/databases/$(database)/documents/playerMapPrivate/$(entryId))
        && get(/databases/$(database)/documents/playerMapPrivate/$(entryId)).data.ownerUid == request.auth.uid
        && after is map
        && (before == null || after.diff(before).affectedKeys().hasOnly([entryId]))
        && (
          !after.keys().hasAny([entryId])
          || (
            validPublicPin(after[entryId])
            && markerPointOk(after[entryId], before == null ? null : before[entryId])
          )
        )
        && boardGrowthOk(after, before)
        && boardBytesOk();
    }

    function createMapBoard() {
      let entryId = get(/databases/$(database)/documents/playerMapOwners/$(request.auth.uid)).data.entryId;
      return request.resource.data.keys().hasOnly(['markers'])
        && request.resource.data.markers is map
        && request.resource.data.markers.keys().hasOnly([entryId])
        && request.resource.data.markers.keys().hasAll([entryId])
        && onlyOwnMarker(request.resource.data.markers, null);
    }

    function updateMapBoard() {
      return resource.data.keys().hasOnly(['markers'])
        && request.resource.data.keys().hasOnly(['markers'])
        && resource.data.markers is map
        && onlyOwnMarker(request.resource.data.markers, resource.data.markers);
    }

    function onlyOwnOpenCard(after, before) {
      let uid = request.auth.uid;
      return uid is string
        && uid.size() > 0
        && uid.size() <= 128
        && after is map
        && (before == null || after.diff(before).affectedKeys().hasOnly([uid]))
        && (
          !after.keys().hasAny([uid])
          || openCard(after[uid])
        )
        && boardGrowthOk(after, before)
        && boardBytesOk();
    }

    function createOpenBoard() {
      return request.resource.data.keys().hasOnly(['players'])
        && request.resource.data.players is map
        && request.resource.data.players.keys().hasOnly([request.auth.uid])
        && request.resource.data.players.keys().hasAll([request.auth.uid])
        && onlyOwnOpenCard(request.resource.data.players, null);
    }

    function updateOpenBoard() {
      return resource.data.keys().hasOnly(['players'])
        && request.resource.data.keys().hasOnly(['players'])
        && resource.data.players is map
        && onlyOwnOpenCard(request.resource.data.players, resource.data.players);
    }

    function contactShape() {
      return request.resource.data.keys().hasOnly([
          'fromUid', 'toUid', 'fromName', 'toName', 'message', 'createdAt', 'read', 'reply', 'repliedAt'
        ])
        && request.resource.data.fromUid is string
        && request.resource.data.toUid is string
        && request.resource.data.fromUid.size() > 0
        && request.resource.data.fromUid.size() <= 128
        && request.resource.data.toUid.size() > 0
        && request.resource.data.toUid.size() <= 128
        && request.resource.data.fromUid.matches('^[A-Za-z0-9_-]+$')
        && request.resource.data.toUid.matches('^[A-Za-z0-9_-]+$')
        && request.resource.data.fromUid != request.resource.data.toUid
        && shortText(request.resource.data.fromName, 60)
        && request.resource.data.fromName.size() > 0
        && shortText(request.resource.data.toName, 60)
        && request.resource.data.toName.size() > 0
        && request.resource.data.message is string
        && request.resource.data.message.size() > 0
        && request.resource.data.message.size() <= 500
        && request.resource.data.createdAt is string
        && request.resource.data.createdAt.size() < 40
        && request.resource.data.read is bool
        && request.resource.data.reply is string
        && request.resource.data.reply.size() <= 500
        && request.resource.data.repliedAt is string
        && request.resource.data.repliedAt.size() < 40;
    }

    // The document id is fromUid_toUid. Only a safe account id is interpolated
    // into the pattern, so a missing thread can be read by either party.
    function contactParty(requestId) {
      return request.auth.uid.matches('^[A-Za-z0-9_-]+$')
        && request.auth.uid.size() <= 128
        && (
          requestId.matches('^' + request.auth.uid + '_.+$')
          || requestId.matches('^.+_' + request.auth.uid + '$')
        );
    }

    function profileCreate(userId) {
      return request.resource.data.keys().hasOnly(['uid', 'email', 'displayName', 'createdAt', 'lastSeenAt', 'lastSignInAt'])
        && request.resource.data.keys().hasAll(['uid', 'email', 'displayName', 'createdAt', 'lastSeenAt', 'lastSignInAt'])
        && request.resource.data.uid == userId
        && request.resource.data.email is string
        && request.resource.data.displayName is string
        && request.resource.data.createdAt is string
        && request.resource.data.lastSeenAt is string
        && request.resource.data.lastSignInAt is string
        && request.resource.data.email.size() < 320
        && authEmailOk()
        && request.resource.data.displayName.size() < 200
        && request.resource.data.createdAt.size() < 40
        && request.resource.data.lastSeenAt.size() < 40
        && request.resource.data.lastSignInAt.size() < 40;
    }

    // The stored address is the Auth token address. An account with no email stores ''.
    function authEmailOk() {
      return request.auth.token.keys().hasAny(['email'])
        ? request.resource.data.email == request.auth.token.email
        : request.resource.data.email == '';
    }

    function profileUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['email', 'displayName', 'lastSeenAt', 'lastSignInAt'])
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.email is string
        && request.resource.data.displayName is string
        && request.resource.data.lastSeenAt is string
        && request.resource.data.lastSignInAt is string
        && request.resource.data.email.size() < 320
        && authEmailOk()
        && request.resource.data.displayName.size() < 200;
    }

    function teamShapeOk() {
      let data = request.resource.data;
      return data.keys().hasOnly(['userId', 'teamName', 'teamData', 'createdAt', 'updatedAt', 'hiddenFromBuddies'])
        && data.userId == request.auth.uid
        && (!('teamName' in data) || (data.teamName is string && data.teamName.size() <= 120))
        && (!('teamData' in data) || data.teamData is map)
        && (!('createdAt' in data) || data.createdAt is timestamp || (data.createdAt is string && data.createdAt.size() < 40))
        && (!('updatedAt' in data) || data.updatedAt is timestamp || (data.updatedAt is string && data.updatedAt.size() < 40))
        && (!('hiddenFromBuddies' in data) || data.hiddenFromBuddies is bool)
        && request.resource.size() < 100000;
    }

    function settingsBool(data, key) {
      return !(key in data) || data[key] is bool;
    }

    function settingsText(data, key, max) {
      return !(key in data) || (data[key] is string && data[key].size() <= max);
    }

    function settingsShapeOk() {
      let data = request.resource.data;
      return data.keys().hasOnly([
          'enableSponsorships', 'includeAdvanced', 'darkMode', 'printStyle',
          'showTeamSummary', 'showGaslandsMath', 'hasRules', 'showExperimentalFeatures',
          'receiveUpdates', 'receiveUpdatesChangedAt',
          'newsletterOptIn', 'newsletterOptInAt', 'newsletterOptOutAt', 'newsletterConsentText',
          'newsletterPromptDismissedAt', 'newsletterSource',
          'showOnPlayersMap', 'allowContactFromPlayers', 'location',
          'showEquipmentDescriptions', 'showPerkDescriptions', 'showSpecialRules'
        ])
        && settingsBool(data, 'enableSponsorships')
        && settingsBool(data, 'includeAdvanced')
        && settingsBool(data, 'darkMode')
        && settingsBool(data, 'showTeamSummary')
        && settingsBool(data, 'showGaslandsMath')
        && settingsBool(data, 'hasRules')
        && settingsBool(data, 'showExperimentalFeatures')
        && settingsBool(data, 'receiveUpdates')
        && settingsBool(data, 'showOnPlayersMap')
        && settingsBool(data, 'allowContactFromPlayers')
        && settingsBool(data, 'showEquipmentDescriptions')
        && settingsBool(data, 'showPerkDescriptions')
        && settingsBool(data, 'showSpecialRules')
        && settingsText(data, 'printStyle', 40)
        && settingsText(data, 'receiveUpdatesChangedAt', 40)
        && settingsText(data, 'location', 120)
        && request.resource.size() < 32000
        && newsletterSettingsOk();
    }

    function messageShapeOk() {
      let data = request.resource.data;
      return data.keys().hasOnly(['userId', 'email', 'subject', 'message', 'createdAt', 'read', 'recipient'])
        && data.userId == request.auth.uid
        && (!('email' in data) || (data.email is string && data.email.size() < 320))
        && (!('subject' in data) || (data.subject is string && data.subject.size() <= 200))
        && (!('message' in data) || (data.message is string && data.message.size() <= 5000))
        && (!('createdAt' in data) || data.createdAt is timestamp || (data.createdAt is string && data.createdAt.size() < 40))
        && (!('read' in data) || data.read is bool)
        && (!('recipient' in data) || (data.recipient is string && data.recipient.size() < 320))
        && request.resource.size() < 20000;
    }

    // Default deny all access
    match /{document=**} {
      allow read, write: if false;
    }

    // Aggregated usage totals only. No team lists, user ids, or other documents.
    // The scheduled job writes with the Admin SDK, which does not use these rules.
    match /stats/{statId} {
      allow read: if statId == 'public';
      allow write: if false;
    }

    function uidOk(uid) {
      return uid is string
        && uid.size() > 0
        && uid.size() <= 128
        && uid.matches('^[A-Za-z0-9_-]+$');
    }

    function accountDisabled(uid) {
      return exists(/databases/$(database)/documents/adminUsers/$(uid))
        && get(/databases/$(database)/documents/adminUsers/$(uid)).data.disabled == true;
    }

    // One accepted document for the pair. The id is the two uids in order, joined
    // with ~. Clients cannot create it; a callable writes it with the Admin SDK.
    function acceptedBuddy(ownerUid) {
      let pair = request.auth.uid < ownerUid
        ? request.auth.uid + '~' + ownerUid
        : ownerUid + '~' + request.auth.uid;
      return uidOk(request.auth.uid)
        && uidOk(ownerUid)
        && request.auth.uid != ownerUid
        && exists(/databases/$(database)/documents/buddies/$(pair))
        && get(/databases/$(database)/documents/buddies/$(pair)).data.status == 'accepted'
        && get(/databases/$(database)/documents/buddies/$(pair)).data.members is list
        && get(/databases/$(database)/documents/buddies/$(pair)).data.members.size() == 2
        && get(/databases/$(database)/documents/buddies/$(pair)).data.members.hasAll([request.auth.uid, ownerUid]);
    }

    // Teams collection rules
    match /teams/{teamId} {
      allow read: if signedIn() && !isDisabled() && resource.data.userId == request.auth.uid;
      // A buddy can read a team that the owner has not hidden. They cannot write it.
      // hiddenFromBuddies must be false on the document. Missing means hidden from buddies
      // until the owner opens their teams and the app fills the field in.
      allow read: if signedIn()
        && !isDisabled()
        && resource.data.hiddenFromBuddies == false
        && acceptedBuddy(resource.data.userId)
        && !accountDisabled(resource.data.userId);
      allow read: if isAdmin();

      allow create: if signedIn()
                    && !isDisabled()
                    && teamShapeOk();

      allow update: if signedIn()
                    && !isDisabled()
                    && resource.data.userId == request.auth.uid
                    && teamShapeOk();

      allow delete: if signedIn()
                    && !isDisabled()
                    && resource.data.userId == request.auth.uid;
    }

    function newsletterText(value) {
      return value is string && value.size() > 10 && value.size() < 40;
    }

    // Monthly-email fields are optional. When present, the types are fixed.
    // Opting in requires the current consent version.
    // Another player cannot read this document. An administrator can read it
    // and cannot write it. Firestore returns every field; the Users page shows
    // consent, email choices, and map preferences. newsletterTokens stays closed.
    function newsletterSettingsOk() {
      let data = request.resource.data;
      return (!('newsletterOptIn' in data) || data.newsletterOptIn is bool)
        && (!('newsletterOptInAt' in data) || newsletterText(data.newsletterOptInAt))
        && (!('newsletterOptOutAt' in data) || newsletterText(data.newsletterOptOutAt))
        && (!('newsletterConsentText' in data) || (data.newsletterConsentText is string && data.newsletterConsentText.size() > 0 && data.newsletterConsentText.size() < 80))
        && (!('newsletterPromptDismissedAt' in data) || newsletterText(data.newsletterPromptDismissedAt))
        && (!('newsletterSource' in data) || (data.newsletterSource is string && data.newsletterSource.size() > 0 && data.newsletterSource.size() < 40))
        && (
          !('newsletterOptIn' in data)
          || (
            data.newsletterOptIn == true
            && newsletterText(data.newsletterOptInAt)
            && data.newsletterConsentText == 'monthly-email-v1'
          )
          || (
            data.newsletterOptIn == false
            && newsletterText(data.newsletterOptOutAt)
          )
        );
    }

    // User settings collection rules.
    // Administrator read is the whole document because rules cannot return a
    // field subset. Writes stay with the owner, including consent fields.
    match /userSettings/{userId} {
      allow read: if signedIn() && !isDisabled() && userId == request.auth.uid;
      allow read: if isAdmin();
      allow create, update: if signedIn() && !isDisabled() && userId == request.auth.uid && settingsShapeOk();
      allow delete: if signedIn() && !isDisabled() && userId == request.auth.uid;
    }

    // Per-user unsubscribe token. Written by the Admin SDK. Clients cannot read or write it.
    match /newsletterTokens/{userId} {
      allow read, write: if false;
    }

    // Messages collection rules
    match /messages/{messageId} {
      allow create: if signedIn()
                    && !isDisabled()
                    && messageShapeOk();

      allow read: if isAdmin();
      allow update, delete: if false;
    }

    // Profile written when a player signs in. Administrators can list these.
    match /users/{userId} {
      allow read: if signedIn() && !isDisabled() && userId == request.auth.uid;
      allow read: if isAdmin();

      allow create: if signedIn() && !isDisabled() && userId == request.auth.uid && profileCreate(userId);
      allow update: if signedIn() && !isDisabled() && userId == request.auth.uid && profileUpdate();
      allow delete: if false;
    }

    // Painted-car photos. Not on the team document: a buddy who can read a team
    // cannot read these. The owner can read, change a caption, and delete.
    // Creating a photo document is reserved for reserveVehiclePhoto (Admin SDK).
    function photoText(value, max) {
      return value is string && value.size() <= max;
    }

    function photoRecord(userId, photoId) {
      let data = request.resource.data;
      return data.keys().hasOnly([
          'photoId', 'userId', 'teamId', 'vehicleId', 'path', 'width', 'height', 'createdAt', 'caption', 'contentType',
          'showToBuddies', 'showOnShareLink', 'showInGallery', 'shareVehicleStats',
          'attachments', 'contentHash', 'shareTeamId', 'shareVehicleId'
        ])
        && data.keys().hasAll([
          'photoId', 'userId', 'teamId', 'vehicleId', 'path', 'width', 'height', 'createdAt', 'caption', 'contentType'
        ])
        && (!('showToBuddies' in data) || data.showToBuddies is bool)
        && (!('showOnShareLink' in data) || data.showOnShareLink is bool)
        && (!('showInGallery' in data) || data.showInGallery is bool)
        && (!('shareVehicleStats' in data) || data.shareVehicleStats is bool)
        && data.photoId == photoId
        && data.photoId.matches('^[A-Za-z0-9_-]{8,40}$')
        && data.userId == userId
        && data.teamId is string
        && data.teamId.size() <= 40
        && (data.teamId.size() == 0 || data.teamId.matches('^[A-Za-z0-9_-]+$'))
        && data.vehicleId is string
        && data.vehicleId.size() <= 64
        && (data.vehicleId.size() == 0 || data.vehicleId.matches('^[A-Za-z0-9_-]+$'))
        && photoText(data.path, 300)
        && (
          data.path.matches('^users/' + userId + '/vehicle-photos/.+')
          || data.path.matches('^users/' + userId + '/photos-library/[A-Za-z0-9_-]{8,40}\\.(webp|jpe?g)$')
        )
        && (!('attachments' in data) || (data.attachments is list && data.attachments.size() <= 100))
        && (!('contentHash' in data) || (data.contentHash is string && (data.contentHash == '' || data.contentHash.matches('^[a-f0-9]{64}$'))))
        && (!('shareTeamId' in data) || (data.shareTeamId is string && data.shareTeamId.size() <= 40))
        && (!('shareVehicleId' in data) || (data.shareVehicleId is string && data.shareVehicleId.size() <= 64))
        && data.width is int
        && data.width > 0
        && data.width <= 1600
        && data.height is int
        && data.height > 0
        && data.height <= 1600
        && data.createdAt is string
        && data.createdAt.size() < 40
        && photoText(data.caption, 140)
        && (data.contentType == 'image/webp' || data.contentType == 'image/jpeg')
        && request.resource.size() < 24000;
    }

    match /users/{userId}/photos/{photoId} {
      allow read: if signedIn() && !isDisabled() && userId == request.auth.uid;
      allow create: if false;
      allow update: if signedIn()
        && !isDisabled()
        && userId == request.auth.uid
        && photoRecord(userId, photoId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['caption'])
        && resource.data.photoId == photoId
        && resource.data.userId == userId
        && request.resource.data.teamId == resource.data.teamId
        && request.resource.data.vehicleId == resource.data.vehicleId
        && request.resource.data.path == resource.data.path
        && request.resource.data.width == resource.data.width
        && request.resource.data.height == resource.data.height
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.contentType == resource.data.contentType
        && request.resource.data.get('showToBuddies', false) == resource.data.get('showToBuddies', false)
        && request.resource.data.get('showOnShareLink', false) == resource.data.get('showOnShareLink', false)
        && request.resource.data.get('showInGallery', false) == resource.data.get('showInGallery', false)
        && request.resource.data.get('shareVehicleStats', false) == resource.data.get('shareVehicleStats', false)
        && request.resource.data.get('attachments', []) == resource.data.get('attachments', [])
        && request.resource.data.get('contentHash', '') == resource.data.get('contentHash', '')
        && request.resource.data.get('shareTeamId', '') == resource.data.get('shareTeamId', '')
        && request.resource.data.get('shareVehicleId', '') == resource.data.get('shareVehicleId', '');
      allow delete: if signedIn() && !isDisabled() && userId == request.auth.uid;
    }

    // Public gallery card. Readable only while it is a published, visible
    // gallery photo. The account id is not stored here. Clients cannot write.
    match /sharedPhotos/{photoId} {
      allow read: if resource.data.hidden == false
        && resource.data.published == true
        && resource.data.showInGallery == true;
      allow read: if isAdmin();
      allow write: if false;
    }

    // Server-only link between a shared file and its owner. Storage rules may
    // read this. Clients cannot.
    match /sharedPhotoPrivate/{photoId} {
      allow read, write: if false;
    }

    match /photoReports/{reportId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /photoReportRate/{userId} {
      allow read, write: if false;
    }

    // Gallery kill switch. requireApproval true holds new gallery photos
    // until an administrator approves them. Callables write it.
    match /config/{docId} {
      allow read: if docId == 'gallery' && isAdmin();
      allow write: if false;
    }

    // Role grants. A player cannot create or edit their own document.
    match /roles/{userId} {
      allow read: if signedIn() && userId == request.auth.uid;
      allow read: if isAdmin();

      allow create, update: if roleWrite(userId);
      allow delete: if isAdmin() && userId != request.auth.uid;
    }

    // Disable flag. The signed-in player can read their own document so the
    // app can sign them out. They cannot write it, including to clear the flag.
    match /adminUsers/{userId} {
      allow read: if signedIn() && userId == request.auth.uid;
      allow read: if isAdmin();

      allow create, update: if accountControlWrite(userId);
      allow delete: if false;
    }

    // Deletion marker. Clients cannot read or clear it. The Admin SDK writes it
    // before Auth is deleted and does not remove it in that same pass.
    match /accountControl/{userId} {
      allow read, write: if false;
    }

    // Per-sender daily cap for game-request email. The Admin SDK writes it.
    match /gameContactEmailRate/{userId} {
      allow read, write: if false;
    }

    // Private player profile. Map pins and contact cards live in other collections
    // so a public read cannot see email, the account id, or a precise location.
    match /playerProfiles/{userId} {
      allow read: if signedIn() && !isDisabled() && userId == request.auth.uid;
      allow read: if isAdmin();

      allow create, update: if signedIn() && !isDisabled() && userId == request.auth.uid && validPlayerProfile();
      allow delete: if signedIn() && !isDisabled() && userId == request.auth.uid;
    }

    // One claim per player. The public pin id is random and is not the account id.
    match /playerMapOwners/{userId} {
      allow read: if signedIn() && !isDisabled() && userId == request.auth.uid;
      allow read: if isAdmin();

      allow create, update: if signedIn()
        && !isDisabled()
        && userId == request.auth.uid
        && request.resource.data.keys().hasOnly(['entryId', 'updatedAt'])
        && request.resource.data.entryId is string
        && request.resource.data.entryId.matches('^[A-Za-z0-9]{20,40}$')
        && request.resource.data.entryId != request.auth.uid
        && request.resource.data.updatedAt is string
        && request.resource.data.updatedAt.size() < 40;
      allow delete: if signedIn() && !isDisabled() && userId == request.auth.uid;
    }

    // Owner of a pin, readable only by that player and administrators.
    // Anonymous pins stay anonymous because this link is not on the public pin.
    match /playerMapPrivate/{entryId} {
      // A missing pin link is readable so the owner can tell it has not been created.
      // resource is null for a missing document; do not touch resource.data in that case.
      allow read: if signedIn() && !isDisabled() && (resource == null || resource.data.ownerUid == request.auth.uid);
      allow read: if isAdmin();

      allow create: if ownsMapClaim(entryId)
        && request.resource.data.keys().hasOnly(['ownerUid'])
        && request.resource.data.ownerUid == request.auth.uid;
      allow update: if false;
      allow delete: if signedIn() && !isDisabled() && resource.data.ownerUid == request.auth.uid;
    }

    // Public pins. Anonymous documents have a coarse coordinate and nothing else.
    // A single document read is allowed. Listing the collection is not: /players
    // reads playerMapBoard/public so a visit cannot scan every pin.
    match /playerMap/{entryId} {
      allow get: if true;
      allow list: if false;

      allow create, update: if ownsMapClaim(entryId)
        && exists(/databases/$(database)/documents/playerMapPrivate/$(entryId))
        && get(/databases/$(database)/documents/playerMapPrivate/$(entryId)).data.ownerUid == request.auth.uid
        && (anonMapEntry() || namedMapEntry())
        && storedPointOk();
      allow delete: if signedIn()
        && !isDisabled()
        && exists(/databases/$(database)/documents/playerMapPrivate/$(entryId))
        && get(/databases/$(database)/documents/playerMapPrivate/$(entryId)).data.ownerUid == request.auth.uid;
    }

    // One public document of map pins. A player may create it or change only the
    // key claimed in playerMapOwners, and only while playerMapPrivate names them.
    // They cannot delete the document or rewrite another player's pin.
    match /playerMapBoard/{docId} {
      allow get: if docId == 'public';
      allow list: if false;

      allow create: if docId == 'public' && signedIn() && !isDisabled() && createMapBoard();
      allow update: if docId == 'public' && signedIn() && !isDisabled() && updateMapBoard();
      allow delete: if false;
    }

    // Server-issued approximate point. Clients cannot read or write it.
    match /mapPlacements/{userId} {
      allow read, write: if false;
    }

    // Contact opt-in. No email and no coordinate. A signed-in player may read one
    // card. Listing the collection is denied; /players reads openToGamesBoard/public.
    match /openToGames/{userId} {
      allow get: if signedIn() && !isDisabled();
      allow list: if false;

      allow create, update: if signedIn() && !isDisabled() && userId == request.auth.uid && validOpenToGames();
      allow delete: if signedIn() && !isDisabled() && userId == request.auth.uid;
    }

    // One document of contact cards, readable by any active signed-in player.
    // The map key has to be the caller's uid, so a write cannot spoof or delete
    // another player's card. The document itself cannot be deleted.
    match /openToGamesBoard/{docId} {
      allow get: if docId == 'public' && signedIn() && !isDisabled();
      allow list: if false;

      allow create: if docId == 'public' && signedIn() && !isDisabled() && createOpenBoard();
      allow update: if docId == 'public' && signedIn() && !isDisabled() && updateOpenBoard();
      allow delete: if false;
    }

    // A game request between two signed-in players. The id is fromUid_toUid.
    // Email is not a field. The recipient must have an openToGames document.
    match /gameContacts/{requestId} {
      // A missing thread is readable by either named party so the sender can
      // tell that the first request has not been created yet. resource is null
      // for a missing document; do not touch resource.data in that case.
      allow read: if signedIn()
        && !isDisabled()
        && (
          (resource == null && contactParty(requestId))
          || (
            resource != null
            && (resource.data.fromUid == request.auth.uid || resource.data.toUid == request.auth.uid)
          )
        );
      allow read: if isAdmin();

      allow create: if signedIn()
        && !isDisabled()
        && requestId == request.resource.data.fromUid + '_' + request.resource.data.toUid
        && contactShape()
        && request.resource.data.fromUid == request.auth.uid
        && request.resource.data.read == false
        && request.resource.data.reply == ''
        && request.resource.data.repliedAt == ''
        && exists(/databases/$(database)/documents/openToGames/$(request.resource.data.toUid));

      allow update: if signedIn()
        && !isDisabled()
        && contactShape()
        && request.resource.data.fromUid == resource.data.fromUid
        && request.resource.data.toUid == resource.data.toUid
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.toName == resource.data.toName
        && (
          (
            resource.data.toUid == request.auth.uid
            && request.resource.data.fromName == resource.data.fromName
            && request.resource.data.message == resource.data.message
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read', 'reply', 'repliedAt'])
          )
          || (
            resource.data.fromUid == request.auth.uid
            && request.resource.data.read == resource.data.read
            && request.resource.data.reply == resource.data.reply
            && request.resource.data.repliedAt == resource.data.repliedAt
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['fromName', 'message'])
            && exists(/databases/$(database)/documents/openToGames/$(resource.data.toUid))
          )
        );

      allow delete: if signedIn()
        && !isDisabled()
        && (resource.data.fromUid == request.auth.uid || resource.data.toUid == request.auth.uid);
    }

    // Accepted buddy links. Written only by the Admin SDK. Either member can read.
    // The list query is members array-contains the caller and status == accepted.
    // Do not add "members is list" here: that check is not implied by the query,
    // so Firestore denies the whole list.
    match /buddies/{pairId} {
      allow read: if signedIn()
        && !isDisabled()
        && resource.data.status == 'accepted'
        && resource.data.members.hasAny([request.auth.uid]);
      allow write: if false;
    }

    // Requests are readable by the sender or the recipient. No email field.
    // Creating, accepting, declining, and blocking go through callables.
    match /buddyRequests/{requestId} {
      allow read: if signedIn() && !isDisabled() && resource.data.toUid == request.auth.uid;
      allow read: if signedIn() && !isDisabled() && resource.data.fromUid == request.auth.uid;
      allow write: if false;
    }

    // The invite code for this account. Other players resolve a code through a callable.
    match /buddyInvites/{userId} {
      allow read: if signedIn() && !isDisabled() && userId == request.auth.uid;
      allow write: if false;
    }

    // Opt-in display name for search. The owner can read their own card.
    // Search runs in a callable so this collection cannot be listed.
    match /buddyDirectory/{userId} {
      allow get: if signedIn() && !isDisabled() && userId == request.auth.uid;
      allow list: if false;
      allow write: if false;
    }

    // Email-invite tokens, recipient hashes, and opt-out tokens.
    // Clients cannot read or write them. Callables use the Admin SDK.
    match /buddyEmailInvites/{inviteId} {
      allow read, write: if false;
    }

    match /buddyEmailOptOuts/{tokenHash} {
      allow read, write: if false;
    }

    match /buddyEmailRate/{addressHash} {
      allow read, write: if false;
    }

    match /buddyEmailSuppress/{addressHash} {
      allow read, write: if false;
    }

    // A block is visible to the person who blocked. The blocked player is not told here.
    match /buddyBlocks/{blockId} {
      allow read: if signedIn()
        && !isDisabled()
        && resource.data.blockerUid == request.auth.uid;
      allow write: if false;
    }
  }
}
