{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "types": ["node"],
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "esModuleInterop": true
  },
	"include": ["src/**/*.ts", "../app/src/lib/buddies/model.ts", "../app/src/lib/buddies/emailInvite.ts", "../app/src/lib/photos/model.ts", "../app/src/lib/photos/share.ts", "../app/src/lib/photos/vehicleStats.ts", "../app/src/lib/photos/carPage.ts"]
}
