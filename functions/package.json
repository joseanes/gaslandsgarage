{
  "name": "functions",
  "private": true,
  "main": "lib/index.js",
  "engines": {
    "node": "20"
  },
  "scripts": {
    "build": "esbuild src/index.ts --bundle --platform=node --target=node20 --format=cjs --outfile=lib/index.js --packages=external --sourcemap",
    "check": "tsc --noEmit",
    "test": "pnpm --config.engine-strict=false dlx firebase-tools@13.29.1 emulators:exec --only auth,firestore --project demo-gaslands-functions --config ../firebase.json \"pnpm exec vitest run\""
  },
  "dependencies": {
    "firebase-admin": "13.10.0",
    "firebase-functions": "6.6.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.17",
    "esbuild": "^0.25.5",
    "typescript": "~5.6.3",
    "vitest": "^3.1.3"
  }
}
